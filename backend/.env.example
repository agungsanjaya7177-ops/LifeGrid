# LifeGrid Backend Configuration
# Copy this file to .env and fill in real values
# WARNING: Never commit the .env file with real secrets to version control

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://lifegrid_user:changeme@localhost:5432/lifegrid_dev

# JWT signing secret (minimum 32 bytes for security)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-minimum-32-bytes-change-this

# JWT access token expiration time in minutes (must be 1-1440)
# Requirement 2.1: 15-60 minutes for login tokens
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS allowed origins (comma-separated list)
# Development: http://localhost:5173 (Vite default)
# Production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
